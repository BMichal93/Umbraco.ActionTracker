{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "SearchPulse": {
    "Enabled": true,
    "DetailedDataRetentionDays": 30
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "285edae5-5538-4fb2-9e89-bcdea387673f",
        "InstallMissingDatabase": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true,
        "InstallUnattended": true,
        "PackageMigrationsUnattended": true,
        "UnattendedUserName": "SearchPulse Integration",
        "UnattendedUserEmail": "searchpulse.integration@example.test",
        "UnattendedUserPassword": "SearchPulse-Test-2026!"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "9UKfAtCqXXWCImF4siYvs27v9iqM4ZZcOUE0TkMJWzVXQT1Tmpnj/VdbvRknOUG5BXmyMlBz4FU7ME9ZoIvRkA=="
      }
    }
  }
}
