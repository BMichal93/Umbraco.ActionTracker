<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>SearchPulse.Umbraco</PackageId>
    <Version>0.1.0-alpha.6</Version>
    <Authors>SearchPulse contributors</Authors>
    <Company>SearchPulse contributors</Company>
    <Description>Simple, privacy-aware content engagement signals for Umbraco.</Description>
    <PackageTags>umbraco;umbraco-marketplace;analytics;seo;privacy</PackageTags>
    <PackageProjectUrl>https://github.com/BMichal93/searchpulse-for-umbraco</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BMichal93/searchpulse-for-umbraco</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <StaticWebAssetBasePath>App_Plugins/SearchPulse</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="[17.6.0, 18.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
