<Project>
  <ItemGroup>
    <StaticWebAsset Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\staticwebassets\App_Plugins\SearchPulse\searchpulse-overview.js'))">
      <SourceType>Package</SourceType>
      <SourceId>SearchPulse.Umbraco</SourceId>
      <ContentRoot>$(MSBuildThisFileDirectory)..\staticwebassets\</ContentRoot>
